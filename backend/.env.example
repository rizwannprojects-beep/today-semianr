# ===================================================================
# Campus Lost & Found System - Environment Configuration Template
# COPY this file to .env and configure secrets prior to deployment
# NEVER commit .env with real secrets to version control
# ===================================================================

# Server Runtime Configuration
PORT=5001
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://campus_app:<PASSWORD>@<CLUSTER>/campus_lost_found?retryWrites=true&w=majority&appName=Cluster0

# Security & JWT Tokens (Must be high-entropy strings >= 32 characters in production)
JWT_SECRET=<STRONG_SECRET_AT_LEAST_32_CHARACTERS>
JWT_REFRESH_SECRET=<STRONG_REFRESH_SECRET_AT_LEAST_32_CHARACTERS>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15

# Initial Admin Bootstrap (Optional for scripts/seedAdmin.js)
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=ReplaceWithStrongPassword123!
ADMIN_REGISTER_NUMBER=ADMIN-001
ADMIN_PHONE=+1-555-0199
ADMIN_DEPARTMENT=Campus Security & Administration
