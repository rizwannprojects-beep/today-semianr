# ===================================================================
# Campus Lost & Found System - Environment Configuration Template
# COPY this file to backend/.env and configure secrets prior to deployment
# NEVER commit .env with real secrets to version control
# ===================================================================

# Server Runtime Configuration
PORT=5001
NODE_ENV=production

# MongoDB Connection URI (Format: mongodb://[user:pass@]host[:port]/database)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_lost_found_db

# Security & JWT Tokens (Must be high-entropy strings >= 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Client Origin for CORS (e.g., https://lostandfound.campus.edu in production)
CLIENT_URL=https://lostandfound.campus.edu

# Rate Limiting Parameters
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=15

# Initial Admin Bootstrap (Used exclusively by scripts/seedAdmin.js)
ADMIN_NAME=Campus Administrator
ADMIN_EMAIL=admin@campus.edu
ADMIN_PASSWORD=ReplaceWithStrongPassword123!
ADMIN_REGISTER_NUMBER=ADMIN-001
ADMIN_PHONE=+1-555-0199
ADMIN_DEPARTMENT=Campus Security & Administration

# Optional: Email Service Provider (If omitted, EmailService operates safely in LOG_ONLY mode)
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM="Campus Lost & Found <noreply@campus.edu>"
